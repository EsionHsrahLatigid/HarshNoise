{
  "version": 6,
  "configurePresets": [
    {
      "name": "engine-debug",
      "displayName": "Engine Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HARSHNOISE_BUILD_PLUGIN": "ON",
        "HARSHNOISE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "Plugin Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HARSHNOISE_BUILD_PLUGIN": "ON",
        "HARSHNOISE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "targets": [
        "HarshNoiseSmokeTests",
        "HarshNoiseEditorTests"
      ]
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "targets": [
        "ehl_stage_products",
        "HarshNoiseSmokeTests",
        "HarshNoiseEditorTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
